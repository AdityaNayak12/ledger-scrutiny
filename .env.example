# Local pitch environment. Replace the secret before any shared deployment.
SECRET_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000

# Backend startup requires GOOGLE_CLIENT_ID. The frontend value enables the button.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
